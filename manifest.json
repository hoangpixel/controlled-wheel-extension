{
  "manifest_version": 3,
  "name": "Fixed Winner Demo",
  "version": "1.0.0",
  "description": "Vòng quay demo có kết quả định trước, hiển thị rõ ràng trên Wheel of Names.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Fixed Winner Demo",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://wheelofnames.com/*"],
    "js": ["wheel-core.js", "page-reader.js", "content.js"],
    "run_at": "document_idle"
  }]
}
