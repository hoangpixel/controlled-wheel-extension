{
  "manifest_version": 3,
  "name": "Fixed Winner Demo",
  "version": "1.4.1",
  "description": "Vòng quay demo có kết quả định trước trên Wheel of Names.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Fixed Winner Demo",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://wheelofnames.com/*"],
    "js": ["wheel-core.js", "native-controller-v440.js", "native-controller.js", "native-discovery.js", "native-module-link.js", "page-bridge.js"],
    "world": "MAIN",
    "run_at": "document_start"
  }, {
    "matches": ["https://wheelofnames.com/*"],
    "js": ["wheel-core.js", "page-reader.js", "content.js"],
    "run_at": "document_idle"
  }]
}
